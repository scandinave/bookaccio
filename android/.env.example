# Copy this file to android/.env and fill it in to produce a SIGNED release build.
#
#   cp android/.env.example android/.env
#
# This file is only read by android/app/build.gradle. It is NOT needed for
# debug builds, for `npx expo run:android`, or for Metro. Without it, the
# release APK is simply built unsigned.
#
# KEYSTORE_FILE is resolved relative to android/app/, so a keystore sitting at
# the repository root is ../../release.keystore from there.

KEYSTORE_FILE=../../release.keystore
KEYSTORE_PASSWORD=changeme
KEY_ALIAS=bookaccio
KEY_PASSWORD=changeme
